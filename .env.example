# 配置模板：复制为 .env 并填入真实值（.env 已被 .gitignore 排除，不会提交）

# ---------- MySQL 数据库连接 ----------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=sms_app
DB_PASSWORD=change-me
DB_NAME=student_management

# Docker 容器内 MySQL 的 root 密码（仅容器内使用）
MYSQL_ROOT_PASSWORD=change-me

# ---------- Token 签名密钥（随机长字符串） ----------
SECRET=change-me
